# Copy to .env (or set these in your shell / IDE run configuration). Never commit real values.
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password
# Optional
# DB_URL=jdbc:mysql://localhost:3306/smart_transit?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
# KINVIA_TOKEN_SECRET=at-least-32-random-characters   (if unset, a random secret is generated per start)
# KINVIA_SEED=true                                    (development seed data on an empty database)
# KINVIA_CORS_ORIGINS=http://localhost:5173
# KINVIA_TIMETABLE_IMPORT=true                        (load the bundled station/train/bus timetable on start-up; set false to skip)
